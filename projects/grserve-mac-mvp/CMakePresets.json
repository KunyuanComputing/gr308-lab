{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_SYSROOT": "macosx",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "mac-arm64-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "mac-arm64-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mac-arm64-asan-ubsan",
      "inherits": "mac-arm64-debug",
      "cacheVariables": {
        "GRSERVE_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "mac-arm64-tsan",
      "inherits": "mac-arm64-debug",
      "cacheVariables": {
        "GRSERVE_SANITIZERS": "thread"
      }
    },
    {
      "name": "linux-amd64-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "mac-arm64-debug", "configurePreset": "mac-arm64-debug" },
    { "name": "mac-arm64-release", "configurePreset": "mac-arm64-release" },
    { "name": "mac-arm64-asan-ubsan", "configurePreset": "mac-arm64-asan-ubsan" },
    { "name": "mac-arm64-tsan", "configurePreset": "mac-arm64-tsan" },
    { "name": "linux-amd64-debug", "configurePreset": "linux-amd64-debug" }
  ],
  "testPresets": [
    { "name": "mac-arm64-debug", "configurePreset": "mac-arm64-debug", "output": { "outputOnFailure": true } },
    { "name": "mac-arm64-release", "configurePreset": "mac-arm64-release", "output": { "outputOnFailure": true } },
    { "name": "mac-arm64-asan-ubsan", "configurePreset": "mac-arm64-asan-ubsan", "output": { "outputOnFailure": true } },
    { "name": "mac-arm64-tsan", "configurePreset": "mac-arm64-tsan", "output": { "outputOnFailure": true } },
    { "name": "linux-amd64-debug", "configurePreset": "linux-amd64-debug", "output": { "outputOnFailure": true } }
  ]
}
